# API pública de vagas
REMOTEOK_API_URL=https://remoteok.com/api

# AWS
AWS_REGION=us-east-1
S3_BUCKET=job-market-intel-agent
S3_RAW_PREFIX=raw/jobs

# LLM (agent/report_generator.py)
ANTHROPIC_API_KEY=sk-ant-...
REPORT_MODEL=claude-sonnet-5

# Telegram (delivery/telegram_notifier.py)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-100123456789

# Databricks (usado pela Lambda para disparar o job semanal)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_JOB_ID=123456789
SECRETS_NAME=job-market-intel-agent/secrets
